# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/borrow-system

# ---- Security ----
# Use a long random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change-me-to-a-long-random-string

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
# Example for production:
#   CORS_ORIGIN=https://borrow-system.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---- Seed admin (only used on first run) ----
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=admin123

# ---- Optional: Cloudinary (persistent image storage) ----
# Get from https://cloudinary.com/console (Account Details → API Environment variable)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# If unset, uploads fall back to local disk (DON'T USE IN PRODUCTION — files disappear on redeploy)
# CLOUDINARY_URL=cloudinary://xxxxxx:yyyyyy@your-cloud-name
